<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Stopwatch benchmark for MicroBVH.cs: build and traversal throughput over tinybvh's suzanne,
		bunny and cryteksponza test scenes. Run with "dotnet run -c Release" from this folder.
		MICROBVH_TESTDATA or the TestData folder at the repository root supplies the scenes, as for
		the tests.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<Nullable>disable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MicroBVH.csproj" />
	</ItemGroup>

</Project>
